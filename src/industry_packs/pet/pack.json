    {
      "key": "product_name",
      "label": "服务项目",
      "value_type": "text",
      "unit": "",
      "role": "dimension",
      "agg": "count",
      "required": true,
      "sort": 1,
      "legacy_column": "product_name"
    },
    {
      "key": "product_sales_qty",
      "label": "服务单数",
      "value_type": "number",
      "unit": "单",
      "role": "quantity",
      "agg": "sum",
